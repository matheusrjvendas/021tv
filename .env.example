# Variáveis necessárias no Render (Environment)
NODE_ENV=production
PORT=10000
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
ADMIN_PASSWORD=defina-uma-senha-forte-para-o-admin

# No Render, use /var/data se o serviço tiver Persistent Disk.
# Sem disco persistente, o banco JSON pode ser perdido após um redeploy.
DATA_DIR=./data
